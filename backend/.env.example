NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mishkat_db
DB_USER=mishkat_user
DB_PASSWORD=mishkat_pass

# JWT
JWT_SECRET=your_very_long_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cron: daily schedule notification time (24h format)
DAILY_SCHEDULE_CRON=0 6 * * 0-3,6
SESSION_REMINDER_CRON=30 */1 * * *
